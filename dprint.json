{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm"
  ],
  "typescript": {
    "lineWidth": 120,
    "useBraces": "always",
    "quoteStyle": "preferSingle",
    "quoteProps": "asNeeded",
    "semiColons": "always",
    "singleBodyPosition": "nextLine",
    "preferHanging": true,
    "preferSingleLine": true
  },
  "json": {},
  "markdown": {},
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/lib",
    "**/*.wasm",
    "bun.lock",
    "**/CHANGELOG.md",
    // Pre-existing malformed JSON (a stray unterminated string), unrelated to
    // this toolchain swap -- not this task's to fix.
    ".vscode/launch.json"
  ]
}
