{
  "name": "@rhombus-toolkit/func",
  "version": "4.0.0",
  "description": "DEPRECATED -- moved to @rhombus-toolkit/types. Kept as a pure re-export shim.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhombus-toolkit/ts.git",
    "directory": "libraries/func"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/bundle/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/bundle/index.d.ts",
      "default": "./dist/bundle/index.d.ts"
    },
    "./generic": {
      "source": "./src/generics.ts",
      "types": "./dist/bundle/generics.d.ts",
      "default": "./dist/bundle/generics.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-lib.ts",
    "lint": "bun x tsc --noEmit -p tsconfig.ci.json"
  },
  "keywords": [],
  "author": "Thomas Butler",
  "dependencies": {
    "@rhombus-toolkit/types": "workspace:*"
  },
  "rhombusBuild": {
    "typesOnly": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "types": "./dist/bundle/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/bundle/index.d.ts",
        "default": "./dist/bundle/index.d.ts"
      },
      "./generic": {
        "types": "./dist/bundle/generics.d.ts",
        "default": "./dist/bundle/generics.d.ts"
      }
    }
  }
}
