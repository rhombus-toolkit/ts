# Type-test files are a build-time gate only — never ship them.
# These match the renamed *.test.ts sources and every compiled artifact
# (lib/, lib-commonjs/) heft emits for them.
*.test.ts
*.test.js
*.test.js.map
*.test.d.ts
*.test.d.ts.map

# Runtime Jest suites (*.spec.ts) and the Jest config are dev-only too.
*.spec.ts
*.spec.js
*.spec.js.map
*.spec.d.ts
*.spec.d.ts.map
config/jest.config.json
