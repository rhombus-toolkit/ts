{
  "name": "@rhombus-toolkit/monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "libraries/*",
    "tests"
  ],
  "scripts": {
    "build": "bun scripts/build-all.ts",
    "test": "bun --filter '*' test",
    "lint": "bun --filter '*' lint",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "knip": "knip --tsConfig tsconfig.knip.json --no-exit-code",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "dprint": "^0.54.0",
    "rollup": "^4.61.0",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.60.1",
    "eslint": "^10.4.1"
  }
}
